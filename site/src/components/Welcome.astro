---
// The landing page under the hero: the agents Mash reads, what the agent
// plugin does in a session, then one band per idea, each with a small mono
// label, a heading and a window or set of cards drawn as the dashboard draws
// them. The windows are illustrations: each is
// one image to assistive technology, named for what it shows. Mashy appears
// only in his own band; the closing call to action shows the app icon, as
// the hero does.

import { Image } from "astro:assets";
import type { Agent } from "../../../dashboard/src/lib/types";
import ferrisArt from "../art/ferris.svg?raw";
import mashy from "../art/mashy.webp";
import { ferrisOrange } from "../brand.ts";
import "../styles/welcome.css";
import "../styles/welcome-panels.css";
import qdrant from "../art/stack/qdrant.svg?raw";
import tauri from "../art/stack/tauri.svg?raw";
import tokio from "../art/stack/tokio.svg?raw";
import Agents from "./Agents.astro";
import AgentTile from "./AgentTile.astro";
import AppIcon from "./AppIcon.astro";
import LineIcon from "./LineIcon.astro";
import OsMark from "./OsMark.astro";
import PluginSteps from "./PluginSteps.astro";
import PrivacyPicture from "./PrivacyPicture.astro";
import Surfaces from "./Surfaces.astro";

/** Ferris, his strokes and solids in his own orange. */
const ferris = ferrisArt.replace('class="ferris"', `class="ferris" style="color: ${ferrisOrange}"`);

/** The projects Mash is built on, shown under Ferris, each with its logo and linked to its own site. */
const built = [
  { name: "Tauri", svg: tauri, colour: "var(--stack-tauri)", href: "https://tauri.app/" },
  { name: "Qdrant", svg: qdrant, colour: "var(--stack-qdrant)", href: "https://qdrant.tech/" },
  { name: "Tokio", svg: tokio, colour: "var(--stack-tokio)", href: "https://tokio.rs/" },
];

/** A Simple Icons mark, drawn in the current colour. */
function mark(svg: string): string {
  return svg
    .replace(/<title>.*?<\/title>/s, "")
    .replace(/\srole="[^"]*"/, "")
    .replace("<svg", '<svg fill="currentColor" aria-hidden="true" focusable="false"');
}

/** The quick search panel's results: a made-up history, as in the demo. Each
 * machine shows its system's mark, as in the search band below. */
const quick: {
  agent: Agent;
  title: string;
  project: string;
  machine: string;
  system: "macos" | "linux" | "windows";
  when: string;
}[] = [
  {
    agent: "claude-code",
    title: "Sign-in tokens for web and mobile",
    project: "billing-api",
    machine: "laptop",
    system: "macos",
    when: "2d",
  },
  {
    agent: "codex",
    title: "Mobile auth: keychain or secure storage",
    project: "mobile",
    machine: "workstation",
    system: "linux",
    when: "5d",
  },
  {
    agent: "cursor",
    title: "Keychain access group for the share extension",
    project: "mobile",
    machine: "mini",
    system: "macos",
    when: "3w",
  },
  {
    agent: "copilot",
    title: "Rotate webhook signing secrets",
    project: "billing-api",
    machine: "laptop",
    system: "macos",
    when: "Nov 12",
  },
  {
    agent: "claude-code",
    title: "Session cookie lifetime on the admin site",
    project: "admin",
    machine: "workstation",
    system: "linux",
    when: "Oct 30",
  },
];
---

<div class="mash-welcome not-content">
  <Agents />

  <PluginSteps />

  <section class="band" id="welcome-shortcuts" aria-labelledby="welcome-shortcuts-title">
    <div class="wrapper shortcuts" data-reveal>
      <div class="head">
        <h2 id="welcome-shortcuts-title">Take shortcuts, not detours.</h2>
        <p class="blurb">Press <kbd>⌥</kbd> <kbd>⇧</kbd> <kbd>Space</kbd> and the chat you need is one line away, found by its exact words or, with local models, by what it meant.</p>
      </div>
      <div class="desk" role="img"
        aria-label="The Mash desktop app's search panel under the menu bar: the search ‘refresh token’ lists five chats from Claude Code, Codex, Cursor and GitHub Copilot across three machines.">
        <div class="desk-screen" aria-hidden="true">
          <i class="glow butter"></i><i class="glow sky"></i><i class="glow peach"></i>
          <div class="menubar">
            <b>Mash</b><span>File</span><span>Edit</span><span>View</span><span>Window</span><span>Help</span>
            <img class="tray" src="/mash-mark.svg" alt="" width="18" height="18" />
            <span class="clock">Wed 25 Nov 10:42</span>
          </div>
          <div class="quick">
            <div class="quick-q"><LineIcon name="search" size="1rem" /><b>refresh token</b><span>All machines</span></div>
            <p class="quick-h">Best matches</p>
            <ul>
              {quick.map((row, index) => (
                <li class:list={{ on: index === 0 }}>
                  <AgentTile agent={row.agent} />
                  <b>{row.title}</b>
                  <span class="where"><LineIcon name="folder" size="0.75rem" />{row.project}<OsMark system={row.system} />{row.machine}</span>
                  <span class="when">{row.when}</span>
                </li>
              ))}
            </ul>
            <div class="quick-f"><span>Open chat <kbd>↵</kbd></span><i></i><span>Open Mash <kbd>⌘</kbd><kbd>O</kbd></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band tint mashy-band" id="welcome-mashy" aria-labelledby="welcome-mashy-title">
    <div class="wrapper split reverse" data-reveal>
      <div class="words">
        <div class="mashy-head">
          <Image src={mashy} alt="" width={144} class="mashy-face" />
          <span class="kicker">Dashboard</span>
        </div>
        <h2 id="welcome-mashy-title">Meet Mashy. <span class="quiet">Ask him anything about your chats.</span></h2>
        <p class="blurb">
          Mashy searches your chats, smooth as butter. He can help you remember what you were
          doing last week or cross-reference between chats. Plus, he’s super cute!
        </p>
        <p class="small">Optional. Requires your own model service and API key.</p>
      </div>
      <div class="mashy-carousel" data-mashy-chat>
        <div class="window mashy-window" role="img"
          aria-label="Three example questions to the read-only assistant, each answered with a quote from the chat it came from: the checkout outage traced to a database migration in Claude Code, yesterday’s flaky test fix in Codex, and a payment retry added in Cursor.">
          <div class="window-h" aria-hidden="true"><u></u><u></u><u></u><span>Ask Mashy</span></div>
          <div class="window-b" aria-hidden="true">
            <div class="examples">
            <div class="example" data-example="1">
              <p class="bubble">What caused the checkout outage last week?</p>
              <div class="answer">
                <img src="/mashy.png" alt="" width="30" height="24" />
                <div>
                  <p>A database migration locked the orders table for about four minutes. Claude Code described the lock on the build box:</p>
                  <div class="quote">
                    <p class="who"><AgentTile agent="claude-code" /><b>Checkout outage review</b><span><OsMark system="windows" />build-box</span></p>
                    <p>“The migration takes an exclusive lock, so checkout writes queue behind it.”</p>
                    <span class="fake-link">Open the message ›</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="example" data-example="2">
              <p class="bubble">What was I working on yesterday?</p>
              <div class="answer">
                <img src="/mashy.png" alt="" width="30" height="24" />
                <div>
                  <p>You were fixing the flaky checkout test with Codex on the workstation. It ended with the cause:</p>
                  <div class="quote">
                    <p class="who"><AgentTile agent="codex" /><b>Fix the flaky checkout test</b><span><OsMark system="linux" />workstation</span></p>
                    <p>“The test keeps failing because it shares a cart with the test before it.”</p>
                    <span class="fake-link">Open the message ›</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="example" data-example="3">
              <p class="bubble">Did the payment retry change touch checkout?</p>
              <div class="answer">
                <img src="/mashy.png" alt="" width="30" height="24" />
                <div>
                  <p>Yes. Cursor added it on the laptop, for when the payment provider times out during checkout:</p>
                  <div class="quote">
                    <p class="who"><AgentTile agent="cursor" /><b>Retry payments after a timeout</b><span><OsMark system="macos" />laptop</span></p>
                    <p>“Added one retry when the payment provider times out during checkout.”</p>
                    <span class="fake-link">Open the message ›</span>
                  </div>
                </div>
              </div>
            </div>
            </div>
          </div>
        </div>
        <div class="pager" hidden>
          <button type="button" class="pager-go" data-go="-1" aria-label="Previous example"><LineIcon name="arrow-left" size="0.875rem" /></button>
          {[1, 2, 3].map((example) => (
            <button type="button" class="dot" data-example-to={example} aria-label={`Show example ${example} of 3`}></button>
          ))}
          <button type="button" class="pager-go" data-go="1" aria-label="Next example"><LineIcon name="arrow-right" size="0.875rem" /></button>
        </div>
      </div>
    </div>
  </section>

  <Surfaces />

  <section class="band tint" id="welcome-speed" aria-labelledby="welcome-speed-title">
    <div class="wrapper stack" data-reveal>
      <div class="head">
        <span class="kicker">Performance</span>
        <h2 id="welcome-speed-title">Fast, and light on your machine.</h2>
      </div>
      <dl class="stats">
        <div>
          <span class="ico"><LineIcon name="zap" /></span>
          <dt><b>66</b><small> ms</small></dt>
          <dd>for an exact-phrase search, at its quickest</dd>
        </div>
        <div>
          <span class="ico"><LineIcon name="database" /></span>
          <dt><b>103</b><small>k</small></dt>
          <dd>messages from 1,137 chats, searched in one index on one machine</dd>
        </div>
        <div>
          <span class="ico"><LineIcon name="chip" /></span>
          <dt><b>5</b><small>×</small></dt>
          <dd>embedding throughput on a Windows GPU</dd>
        </div>
        <div>
          <span class="ico"><LineIcon name="rocket" /></span>
          <dt><b>9</b><small>×</small></dt>
          <dd>embedding throughput with an experimental NVIDIA worker</dd>
        </div>
      </dl>
      <details class="measured">
        <summary>How these were measured</summary>
        <div class="measurement-copy" role="region" aria-label="Benchmark conditions" tabindex="0">
          <dl>
            <div>
              <dt>66 ms and 103k</dt>
              <dd>One exact-phrase search across 1,137 chats and about 103,000 searchable messages in one index on one Linux machine. A common word took up to a second there.</dd>
            </div>
            <div>
              <dt>5× and 9×</dt>
              <dd>Embedding throughput while indexing, on a Tesla T4 against four CPU cores. DirectML on Windows processed about 90 messages a second versus 17 on CPU. The experimental NVIDIA worker processed about 155 versus 18 on CPU.</dd>
            </div>
          </dl>
          <p>
            The NVIDIA worker and GPU reranking are experimental and off until
            you <a href="/configuration/">turn them on</a>.
          </p>
        </div>
      </details>
    </div>
  </section>

  <section class="band" id="welcome-privacy" aria-labelledby="welcome-privacy-title">
    <div class="wrapper split" data-reveal>
      <div class="words">
        <span class="kicker">Privacy</span>
        <h2 id="welcome-privacy-title">Self-hosted, end to end. <span class="quiet">No cloud. No account.</span></h2>
        <p class="blurb">
          Indexing and search run on your machine, and work offline once the local search service
          is running. Sharing, remote workers and Mashy stay off until you turn each one on,
          and <a href="/search-across-machines/">search across machines</a> goes through a Mash
          server you run. Mash masks common keys and tokens in results and outgoing shared history
          by default, though backups can still contain sensitive text.
        </p>
        <a class="more" href="/privacy/">How Mash handles your history ›</a>
      </div>
      <PrivacyPicture />
    </div>
  </section>

  <section class="band" id="welcome-rust" aria-labelledby="welcome-rust-title">
    <div class="wrapper split rust" data-reveal>
      <div class="words">
        <span class="kicker">Open source</span>
        <h2 id="welcome-rust-title">Written with <span class="under">&lt;3</span> in Rust.</h2>
        <p class="blurb">
          Mash is free and open source under the MIT and Apache 2.0 licenses. Ideas, issues and pull
          requests are welcome.
        </p>
        <p class="links">
          <a class="more" href="https://github.com/mashhq/mash">Read the source ›</a>
          <a class="more" href="https://github.com/mashhq/mash/blob/main/CONTRIBUTING.md">Contribute ›</a>
        </p>
      </div>
      <div class="rust-art">
        <!-- Ferris, Rust's unofficial mascot, drawn in his own orange; the band's scene draws him a stroke at a time. -->
        <Fragment set:html={ferris} />
        <div class="built-with">
          <p>Built with</p>
          <ul class="built" aria-label="Built with">
            {built.map((part) => (
              <li>
                <a href={part.href}>
                  <span class="tile" aria-hidden="true" style={`color: ${part.colour}`} set:html={mark(part.svg)} />
                  {part.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="close" aria-labelledby="welcome-close">
    <div class="closing" data-reveal>
      <i class="close-glow" aria-hidden="true"></i>
      <AppIcon id="close-icon" class="close-icon" />
      <h2 id="welcome-close">Give your agents their history back.</h2>
      <p class="actions">
        <a class="button" href="/quick-start/"><LineIcon name="rocket" size="1rem" />Get started</a>
        <a class="button secondary" href="/guides/"><LineIcon name="book-open" size="1rem" />Read the docs</a>
      </p>
    </div>
  </section>
</div>

<script>
  import { mountWelcome } from "../welcome.ts";

  let unmount: (() => void) | undefined;
  // Runs on the first load and after each page change; leaving the page stops it.
  document.addEventListener("astro:page-load", () => {
    unmount?.();
    unmount = undefined;
    const root = document.querySelector<HTMLElement>(".mash-welcome");
    if (root) unmount = mountWelcome(root);
  });
</script>
